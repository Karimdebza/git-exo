
Algo HelloWorld {
 fonction principale {
// Création de la fenetre
 Créer une fenetre de titre ‘Hello world’
Mettre la dimension à 600, 200
Configurer la fenetre sur ‘exitOnClose’
// Création du label de texte
Créer un label avec du texte aligné à gauche et contenant le texte ‘Hello world’
Mettre la couleur bleu sur le label
Mettre la couleur de fond de la fenetre à vert
// Finalisation
Ajouter le lable sur la fenetre
Afficher la fenêtre
}
}


